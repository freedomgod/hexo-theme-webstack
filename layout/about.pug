- const setting = Object.assign({}, theme, page)
body.page-body.boxed-container.about-page
  nav.navbar.horizontal-menu.navbar-fixed-top
    .navbar-inner
      .navbar-brand
        a(href=url_for('/index.html')).logo
          img.hidden-xs(src=url_for(theme.logo.expanded), width='180px', alt=config.title)
          img.visible-xs(src=url_for(theme.logo.expanded), width='180px', alt=config.title)
      .navbar-mobile-clear
      if theme.githubCorner
        != theme.githubCorner

  .page-container
    main#main-content.main-content
      .row
        .col-md-12
          .panel.panel-default
            if theme.aboutPage && theme.aboutPage.website
              h4.text-gray= theme.aboutPage.website.head
              .panel-body
                .row
                  .col-sm-12
                    != theme.aboutPage.website.html
            else
              .panel-body

            if theme.aboutPage && theme.aboutPage.webmaster
              h4.text-gray= theme.aboutPage.webmaster.head
              .row
                .col-sm-4
                  a.resource-card(href=url_for(theme.aboutPage.webmaster.url) target='_blank' rel='noopener noreferrer')
                    span.resource-icon
                      img(src=url_for(theme.aboutPage.webmaster.img) width='40' height='40' alt='')
                    span.resource-copy
                      strong.resource-name= theme.aboutPage.webmaster.name
                      span.resource-description= theme.aboutPage.webmaster.description
                .col-md-8
                  .row
                    .col-sm-12
                      != theme.aboutPage.webmaster.html
                  br
  include common/footer
