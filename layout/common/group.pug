section.resource-section(aria-label=menuName)
  .section-heading
    h2.text-gray(id=menuName.replace(/[\s]+/g, '-'))
      i.linecons-tag(aria-hidden='true')
      = menuName
    span.section-count(aria-label=menus.length + ' 个网站')= menus.length
  .resource-grid
    each menu in menus
      a.resource-card(href=url_for(menu.url) target='_blank' rel='noopener noreferrer' title=menu.name + ' · ' + menu.description)
        span.resource-icon
          img(src=url_for(menu.img) loading='lazy' decoding='async' width='40' height='40' alt='' onerror="this.hidden = true")
        span.resource-copy
          strong.resource-name= menu.name
          span.resource-description= menu.description
        i.fas.fa-arrow-up.resource-arrow(aria-hidden='true')
