footer.main-footer.sticky.footer-type-1
  .footer-inner
    p
      - var now = new Date().getFullYear()
      | &copy; #{setting.since === now ? setting.since : (setting.since + " - " + now)}
      |
      a(href="javascript:void(0);")
        strong= config.author
      |  | Design by
      a(href="http://viggoz.com", target="_blank")
        strong Viggo
      |  | Power by
      a(href="https://hexo.io/", target="_blank")
        strong Hexo
      |  &
      a(href="https://github.com/HCLonely/hexo-theme-webstack/", target="_blank")
        strong hexo-theme-webstack

    if setting.busuanzi && setting.busuanzi.enable && setting.busuanzi.position === 'footer'
      p
        span#busuanzi_container_site_pv!= setting.busuanzi.pv.replace(/\$pv/i,'<span id="busuanzi_value_site_pv"></span>')
        |  |
        span#busuanzi_container_site_uv!= setting.busuanzi.uv.replace(/\$uv/i,'<span id="busuanzi_value_site_uv"></span>')

    .go-up
      a(href="#", rel="go-top" aria-label='回到顶部' title='回到顶部')
        i.fas.fa-angle-up

//- 引入 JavaScript 文件
each jsFile in [setting.js.bootstrap, setting.js.TweenMax, setting.js.resizeable, setting.js.joinable, setting.js.xenonApi, setting.js.xenonToggles, setting.js.xenonCustom]
  script(src=url_for(jsFile))

if setting.busuanzi && setting.busuanzi.enable
  script(async, src=url_for(setting.js.busuanzi))

if page.type !== "about"
  script(src=url_for(setting.js.lozad))

if setting.js && setting.js.footer
  script(src=url_for(setting.js.footer))

if setting.custom && setting.custom.body
  != setting.custom.body
