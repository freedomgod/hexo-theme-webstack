{
  "name": "hexo-theme-webstack-next",
  "version": "3.0.5-freedomgod.2",
  "private": true,
  "description": "WebStack Next: a Hexo navigation theme with local SQLite bookmarks, maintained by freedomgod.",
  "keywords": [
    "hexo",
    "theme",
    "webstack"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node tools/hexo-dev.cjs server",
    "build": "node tools/hexo-dev.cjs generate",
    "test": "node tools/verify-install.cjs && node --test test/*.test.cjs",
    "test:bookmarks": "node --test test/*.test.cjs",
    "bookmarks:sample": "node tools/create-bookmark-example.cjs",
    "postinstall": "node ./move_config.js"
  },
  "author": "HCLonely <h1606051253@gmail.com>",
  "contributors": [
    "freedomgod (https://github.com/freedomgod)"
  ],
  "homepage": "https://github.com/freedomgod/hexo-theme-webstack#readme",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/freedomgod/hexo-theme-webstack"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/freedomgod/hexo-theme-webstack.git"
  },
  "dependencies": {
    "hexo-renderer-pug": "^3.0.0",
    "hexo-util": "^4.0.0",
    "js-yaml": "^4.1.0",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "hexo": "8.1.2",
    "hexo-server": "3.0.0"
  }
}
