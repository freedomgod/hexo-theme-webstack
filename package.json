{
  "name": "hexo-theme-webstack-next",
  "version": "3.0.6",
  "description": "WebStack Next: a Hexo navigation theme with local SQLite bookmarks, maintained by freedomgod.",
  "keywords": [
    "hexo",
    "hexo-theme",
    "theme",
    "webstack",
    "navigation",
    "bookmarks"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node tools/hexo-dev.cjs server",
    "build": "node tools/hexo-dev.cjs generate",
    "test": "node tools/verify-install.cjs && node --test test/*.test.cjs",
    "test:bookmarks": "node --test test/*.test.cjs",
    "bookmarks:sample": "node tools/create-bookmark-example.cjs",
    "postinstall": "node ./move_config.js"
  },
  "author": "freedomgod (https://github.com/freedomgod)",
  "contributors": [
    "HCLonely <h1606051253@gmail.com> (https://github.com/HCLonely)"
  ],
  "homepage": "https://github.com/freedomgod/hexo-theme-webstack-next#readme",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/freedomgod/hexo-theme-webstack-next"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/freedomgod/hexo-theme-webstack-next.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "hexo": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "hexo": {
      "optional": true
    }
  },
  "dependencies": {
    "hexo-renderer-pug": "^3.0.0",
    "hexo-util": "^4.0.0",
    "js-yaml": "^4.1.0",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "hexo": "8.1.2",
    "hexo-server": "3.0.0"
  }
}
